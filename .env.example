# Application Environment
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Admin Authentication (placeholder for development, set in production)
ADMIN_TOKEN=dev_secret_token_123

# Database configuration (Defaults to local JSON/file-backed repository if empty)
DATABASE_URL=file:./data/leads.json

# AI Qualification & Enrichment (Google Gemini API)
GEMINI_API_KEY=

# Outreach Configuration
OUTREACH_SENDER_NAME="Raj"
OUTREACH_SENDER_EMAIL="raj@d4f.me"

# Target Market Default Config
DEFAULT_MARKET="US"
DAILY_RECOMMENDATION_LIMIT=5

# Brevo Transactional Email Service
# Used strictly for 1-to-1 personal outreach sent from Raj <raj@d4f.me> after human review.
# SECURITY NOTE: Never commit your real API key to Git. Keep real keys ONLY in .env.local
# or in your production deployment secret store (e.g. systemd environment or secret vault).
BREVO_API_KEY=
# Optional: Set to 'true' to safely simulate email dispatching without contacting Brevo's live servers.
BREVO_DRY_RUN=true

# Cloudflare Hybrid Edge Hosting (Optional)
# Used to publish self-contained preview websites and client sites directly to Cloudflare Edge KV.
# Normal visitors access live.d4f.me with zero runtime dependency on Raspberry Pi uptime.
# Real credentials belong ONLY in .env.local or your deployment secrets store.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_EDGE_DOMAIN=live.d4f.me
